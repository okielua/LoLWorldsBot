[Unit]
Description=Worlds Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=worldsbot
Group=worldsbot
WorkingDirectory=/opt/worldsbot
Environment=BOT_ENV_FILE=/opt/worldsbot/.env.production
Environment=BOT_MODE=production
ExecStart=/opt/worldsbot/.venv/bin/python -u /opt/worldsbot/bot.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/worldsbot/data/production

[Install]
WantedBy=multi-user.target
